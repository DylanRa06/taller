{
  "info": {
    "name": "Taller - Vehículos, mecánicos y reparaciones",
    "description": "Ejecutar en orden con la aplicación iniciada y placa ABC123 disponible. Los IDs se guardan automáticamente. Eliminar primero la reparación para respetar las claves foráneas. PUT de reparación actualiza costo, descripción y fechas, como en el video.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "mecanicoId",
      "value": ""
    },
    {
      "key": "segundoMecanicoId",
      "value": ""
    },
    {
      "key": "reparacionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Crear vehículo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/vehiculos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"placa\": \"ABC123\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": \"2020\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Crear primer mecánico",
